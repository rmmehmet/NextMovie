# ── Python Recommendation Servisi ────────────────────────────
REC_SERVICE_URL=http://localhost:8001

# Python servisi Docker'da ayrı container olarak çalışıyorsa false yap:
PYTHON_SERVICE_ENABLED=true
PYTHON_SERVICE_PATH=../recommendation-service
# Windows'ta python3 yerine python olabilir:
PYTHON_COMMAND=python

# ── Frontend CORS ─────────────────────────────────────────────
# Birden fazla URL virgülle ayır:
# FRONTEND_URL=http://localhost:5173,https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Upload ───────────────────────────────────────────────────
